if [ -z "${SSH_ORIGINAL_COMMAND}" ]; then
	echo "This script can only be executed via SSH remote calls"
	exit
fi

case "$SSH_ORIGINAL_COMMAND" in
#	*\&*)
#		#reject any command with a &
#		echo "Rejected 1"
#		;;
#	*\(*)
#		echo "Rejected 2"
#		;;
	*\{*)
		echo "Rejected 3"
		;;
#	*\;*)
#		#reject any command with a ;
#		echo "Rejected 4"
#		;;
 	*\<*)
		echo "Rejected 5"
		;;
	*\`*)
		echo "Rejected 6"
		;;
	*\|*)
		echo "Rejected 7"
		;;
	"whoami")
		# test case 
		whoami
		;;
	"env")
		env
		;;
       	"ssh"*)
                eval $SSH_ORIGINAL_COMMAND
                ;;
	"scp"*)
		eval $SSH_ORIGINAL_COMMAND
		;;
        "stat"*)
                eval $SSH_ORIGINAL_COMMAND
                ;;
  	*)
   		echo "Unauthorized Command : $SSH_ORIGINAL_COMMAND"
		;;
esac
exit

